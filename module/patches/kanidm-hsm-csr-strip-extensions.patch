+                    .map_err(|_| TpmError::X509RequestSign)?;
+                let h = Header::decode(&mut r)
+                    .map_err(|_| TpmError::X509RequestSign)?;
+                let hdr_len = body[pos..].len() - usize::try_from(r.remaining_len()).unwrap();
